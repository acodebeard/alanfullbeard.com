includes:
  - vendor/szepeviktor/phpstan-wordpress/extension.neon

parameters:
  level: 3
  scanDirectories:
    - wp-content/plugins/waypoints-trip-planner/src
  scanFiles:
    - wp-content/themes/alanfullbeard/inc/contact-form.php
    - wp-content/mu-plugins/alanfullbeard-filehub.php
    - wp-content/mu-plugins/alanfullbeard-contact-vault.php
    - wp-content/mu-plugins/alanfullbeard-security-headers.php
    - deploy/contact-vault-backup-stream-lib.php
    - deploy/migrate-hostgator-contact-vault.php
    - deploy/purge-hostgator-flamingo-contacts.php
    - deploy/hostgator-portfolio-page-lib.php
    - deploy/dry-run-hostgator-portfolio-page.php
    - deploy/create-hostgator-portfolio-page.php
    - deploy/rollback-hostgator-portfolio-page.php
    - stubs/flamingo.stub
  paths:
    - app
    - public
    - tests
